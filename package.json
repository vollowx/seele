{
  "name": "@vollowx/seele",
  "version": "0.14.2",
  "description": "An extensible Web Components library, with Material 3 components pre-provided.",
  "author": "vollowx",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/all.js",
  "module": "./src/all.js",
  "exports": {
    ".": {
      "types": "./src/all.d.ts",
      "default": "./src/all.js"
    },
    "./*.js": {
      "types": "./src/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/m3/styles/*.css",
    "custom-elements.json",
    "LICENSE",
    "README.md"
  ],
  "customElements": "custom-elements.json",
  "keywords": [
    "web-components",
    "material-design",
    "material-3",
    "lit",
    "ui-components"
  ],
  "homepage": "https://tideover.cc/seele/",
  "repository": {
    "type": "git",
    "url": "https://github.com/vollowx/seele.git"
  },
  "scripts": {
    "note": "echo 'tsc must be called after build:css since it completes missing *-styles.css.js'",

    "dev": "web-dev-server",
    "dev:css": "bun scripts/convert-css.ts --watch",
    "build": "bun run build:css && tsc && bun scripts/minify-html-literals.ts",
    "build:css": "bun scripts/convert-css.ts --minify",
    "clean": "./scripts/clean.sh",
    "prepublishOnly": "bun clean && bun run build",
    "format": "prettier . --check",
    "format:write": "prettier . --check --write",
    "cem": "cem analyze --litelement --globs './src/m3/**/*.ts'"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^26.1.2",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^1.0.5",
    "chokidar": "^5.0.0",
    "lightningcss": "^1.33.0",
    "minify-html-literals": "^1.3.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "lit": "^3.3.3",
    "tslib": "^2.8.1"
  }
}
