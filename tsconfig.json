{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    // FIXME: this's removes the error for .css.js imports, should think of
    //        other ways to type these files
    "noImplicitAny": false,

    "importHelpers": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"]
}
